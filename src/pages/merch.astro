---
import Analytics from "../components/Analytics.astro";

const bandcampUrl = "https://thetravellerproject.bandcamp.com/track/wanderer-with-no-name-24-bit";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Merch | The Traveller Project</title>
  <meta name="description" content="Support The Traveller Project. Buy and download music on Bandcamp, and shop for apparel including the Black Sun EP t-shirt." />
  <link rel="canonical" href="https://www.thetravellerprojectmusic.co.uk/merch/" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://www.thetravellerprojectmusic.co.uk/merch/" />
  <meta property="og:title"       content="Merch | The Traveller Project" />
  <meta property="og:description" content="Support The Traveller Project. Buy and download music on Bandcamp, and shop for apparel." />
  <meta property="og:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Merch | The Traveller Project" />
  <meta name="twitter:description" content="Support The Traveller Project. Buy and download music on Bandcamp, and shop for apparel." />
  <meta name="twitter:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <link rel="icon" type="image/png" href="/favicon.png?v=4" />
  <link rel="apple-touch-icon" href="/favicon.png?v=4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />

  <script async src="https://js.stripe.com/v3/buy-button.js"></script>

  <Analytics />
</head>

<body>

  <header class="topnav" aria-label="Site navigation">
    <div class="topnav__inner">
      <a class="topnav__logo" href="/">
        <img src="/images/TravProjText.png" alt="The Traveller Project" class="topnav__wordmark" />
      </a>
      <nav class="topnav__links">
        <a class="topnav__item" href="/">Home</a>
        <a class="topnav__item" href="/live/">Live</a>
        <a class="topnav__item" href="/merch/">Merch</a>
        <a class="topnav__item" href="/contact/">Contact</a>
        <a class="topnav__item topnav__item--cta" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </header>

  <div class="page-body merch-page">

    <header class="merch-header">
      <h1 class="merch-header__title">Merch</h1>
      <p class="merch-header__sub">Support the project and take the music home.</p>
    </header>

    <section class="merch-band" aria-label="Bandcamp">
      <div class="merch-band__inner">
        <div class="merch-band__text">
          <h2 class="section-label">Digital downloads</h2>
          <p class="merch-band__desc">
            Buy and download The Traveller Project's music directly on Bandcamp.
            Name your price, keep it forever, and support the project directly.
          </p>
        </div>
        <a class="btn btn--primary merch-band__cta" href={bandcampUrl} target="_blank" rel="noreferrer">
          <img src="/icons/bandcamp.svg" alt="" aria-hidden="true" width="20" height="20" />
          Buy on Bandcamp
        </a>
      </div>
    </section>

    <section class="merch-products" aria-label="Apparel">
      <h2 class="section-label">Apparel</h2>
      <div class="merch-product">
        <div class="merch-product__gallery">
          <img
            class="merch-product__img"
            src="/images/front-unisex-organic-oversized-high-neck-blaster-2.0-t-shirt-black-front-6a9c9002617e2.png"
            alt="The Black Sun Black T Shirt, front"
          />
          <img
            class="merch-product__img"
            src="/images/back-unisex-organic-oversized-high-neck-blaster-2.0-t-shirt-black-back-6a9c9002622f6.png"
            alt="The Black Sun Black T Shirt, back"
          />
        </div>
        <div class="merch-product__body">
          <h3 class="merch-product__name">The Black Sun Black T Shirt</h3>
          <p class="merch-product__desc">
            The official debut merch from The Traveller Project. A unisex oversized black t-shirt
            featuring the full artwork from The Black Sun EP across the back. The Traveller Project
            sits on the front chest. Printed on organic high-quality material.
          </p>
          <p class="merch-product__price">£30</p>
          <div class="merch-product__cta">
            <div class="merch-product__buybox">
              <stripe-buy-button
                buy-button-id="buy_btn_1UCRSy1XY09uUQbAWpNQrEhx"
                publishable-key="pk_live_51TTRKn1XY09uUQbAWvvIto8vLrW4R7tJPHFAg7gFvY2ezFcaYVoRE2u8CdebnY4lNQUdt0ovTRsX4D1trwIgdSMw00TksKUa1w"
              >
              </stripe-buy-button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="merch-legal" aria-label="Ordering information">
      <p>
        Apparel is printed to order by our print partner. Delivery estimates are shown at checkout.
        You can cancel your order for a full refund within 14 days of receiving it: email
        <a href="mailto:travellerprojectmusic@gmail.com">travellerprojectmusic@gmail.com</a> to arrange a return
        or ask about an existing order. Products are sold by Joshua Chalfen, trading as
        The Traveller Project.
      </p>
    </section>

  </div>

  <footer class="footer">
    <form class="footer__signup" action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0" method="post" target="_blank">
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
      </div>
      <label class="footer__signup-label" for="footer-email">Join the mailing list</label>
      <div class="footer__signup-row">
        <input id="footer-email" class="footer__signup-input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
        <button class="btn btn--ghost footer__signup-btn" type="submit">Subscribe</button>
      </div>
    </form>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="/live/">Live</a>
      <a href="/merch/">Merch</a>
      <a href="/contact/">Contact</a>
    </nav>
    <small class="footer__legal">
      © {new Date().getFullYear()} The Traveller Project · Joshua Chalfen
    </small>
  </footer>

</body>
</html>
