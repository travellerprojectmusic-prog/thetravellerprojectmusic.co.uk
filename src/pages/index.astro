---
const release = {
  title: "Blood Brother",
  art: "/images/bloodbrother.gif",
  desc: "A vengeful alt-rock anthem with tense rhythms and tube-screaming acoustic guitars.",
  spotifyUrl: "https://open.spotify.com/artist/7abQsJjZoo5OOd3J2QNQil?si=S-XEpKvQRtqOlyWR06ODlQ",
};

const platforms = [
  { label: "Spotify",     href: "https://open.spotify.com/artist/7abQsJjZoo5OOd3J2QNQil?si=S-XEpKvQRtqOlyWR06ODlQ", icon: "/icons/spotify.svg" },
  { label: "Apple Music", href: "https://music.apple.com/gb/artist/the-traveller-project/1855606340",                icon: "/icons/applemusic.svg" },
  { label: "Bandcamp",    href: "https://thetravellerproject.bandcamp.com/track/wanderer-with-no-name-24-bit",       icon: "/icons/bandcamp.svg" },
  { label: "Tidal",       href: "https://tidal.com/artist/70347746",                                                 icon: "/icons/tidal.svg" },
  { label: "SoundCloud",  href: "https://soundcloud.com/thetravellerproject-music",                                  icon: "/icons/soundcloud.svg" },
  { label: "YouTube",     href: "https://www.youtube.com/@TheTravellerProjectmusic",                                 icon: "/icons/youtube.svg" },
  { label: "Instagram",   href: "https://www.instagram.com/travellerprojectmusic/",                                  icon: "/icons/instagram.svg" },
  { label: "TikTok",      href: "https://www.tiktok.com/@travellerproject",                                          icon: "/icons/tiktok.svg" },
  { label: "Facebook",    href: "https://www.facebook.com/travellerprojectmusic/",                                   icon: "/icons/facebook.svg" },
];

const newsItems = [
  { date: "2026-05-04", title: "New single incoming",                        meta: "Humanity arrives this summer." },
  { date: "2026-03-27", title: "Blood Brother: out now",                    meta: "A vengeful alt-rock anthem, out on all platforms." },
  { date: "2026-02-20", title: "The Black Sun EP released",                  meta: "Embark on the first journey into the Traveller Project universe." },
  { date: "2026-01-04", title: "Wanderer With No Name (Acoustic)",           meta: "A cosy, fireside version is live on YouTube." },
  { date: "2026-01-02", title: "Wanderer With No Name: out now",             meta: "Available on all streaming platforms." },
];

function fmtDate(iso: string) {
  return new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>The Traveller Project | Blood Brother: Out Now</title>
  <meta name="description" content="The Traveller Project is a British alt-rock artist blending warm guitar tones with experimental electronica. Blood Brother is out now on all platforms." />
  <link rel="canonical" href="https://www.thetravellerprojectmusic.co.uk/" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://www.thetravellerprojectmusic.co.uk/" />
  <meta property="og:title"       content="The Traveller Project | Blood Brother: Out Now" />
  <meta property="og:description" content="A British alt-rock artist blending warm guitar tones with experimental electronica. Blood Brother is out now." />
  <meta property="og:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="The Traveller Project | Blood Brother: Out Now" />
  <meta name="twitter:description" content="A British alt-rock artist blending warm guitar tones with experimental electronica. Blood Brother is out now." />
  <meta name="twitter:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <link rel="icon"             type="image/png" href={`${import.meta.env.BASE_URL}favicon.png?v=4`} />
  <link rel="apple-touch-icon"                  href={`${import.meta.env.BASE_URL}favicon.png?v=4`} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MusicGroup",
    "name": "The Traveller Project",
    "url": "https://www.thetravellerprojectmusic.co.uk",
    "genre": ["Alt-rock", "Ambient", "Electronic"],
    "sameAs": [
      "https://open.spotify.com/artist/7abQsJjZoo5OOd3J2QNQil",
      "https://music.apple.com/gb/artist/the-traveller-project/1855606340",
      "https://thetravellerproject.bandcamp.com",
      "https://www.instagram.com/travellerprojectmusic/",
      "https://www.youtube.com/@TheTravellerProjectmusic",
      "https://www.facebook.com/travellerprojectmusic/"
    ]
  }
  </script>
</head>

<body>

  <header class="topnav" aria-label="Site navigation">
    <div class="topnav__inner">
      <a class="topnav__logo" href="/">
        <img src="/images/TravProjText.png" alt="The Traveller Project" class="topnav__wordmark" />
      </a>
      <nav class="topnav__links">
        <a class="topnav__item" href="/">Home</a>
        <a class="topnav__item" href="/live/">Live</a>
        <a class="topnav__item" href="/merch/">Merch</a>
        <a class="topnav__item" href="/contact/">Contact</a>
        <a class="topnav__item topnav__item--cta" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </header>

  <section class="hero" aria-label="Latest release" id="top">
    <div class="hero__inner">
      <div class="hero__text">
        <span class="hero__label">Out now</span>
        <img class="hero__wordmark" src="/images/TravProjText.png" alt="The Traveller Project" />
        <h1 class="hero__title">{release.title}</h1>
        <p class="hero__desc">{release.desc}</p>
        <div class="hero__ctas">
          <a class="btn btn--primary" href={release.spotifyUrl} target="_blank" rel="noreferrer">
            <img src="/icons/spotify.svg" alt="" aria-hidden="true" width="20" height="20" />
            Listen on Spotify
          </a>
          <a class="btn btn--ghost" href="#listen">All platforms ↓</a>
        </div>
      </div>

      <div class="hero__art-wrap">
        <img class="hero__art" src={release.art} alt="Blood Brother — The Traveller Project cover art" />
      </div>
    </div>

    <a class="hero__scroll" href="#about" aria-label="Scroll to more content">
      <svg width="30" height="18" viewBox="0 0 22 13" fill="none" aria-hidden="true">
        <path d="M1 1L11 11L21 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  <div class="page-body">

    <section class="identity" id="about" aria-labelledby="identity-heading">
      <h2 class="section-label" id="identity-heading">What is The Traveller Project?</h2>
      <p class="identity__bio">
        Raw vocals, acoustic rock riffs and lofi drums power the emotional stories of The Traveller Project, the solo project of Josh Chalfen, a live-looping singer-songwriter from Suffolk, based in Highgate, North London.
      </p>
      <p class="identity__bio">
        The project explores our place in the universe, the intense emotions that drive us and our search for direction. The music centres on what Josh calls "the veil" - the boundary between our immediate reality and everything beyond it. The sound draws from Gorillaz, Tunng, Mark Knopfler and Everlast into one unmistakable sound.
      </p>
      <p class="identity__bio">
        The Black Sun EP, a story about confronting fear and finding your way through life, is out now on all platforms.
      </p>
    </section>

    <section class="signup" aria-labelledby="signup-heading">
      <h2 class="section-label" id="signup-heading">Stay in the loop</h2>
      <p class="signup__desc">New music, demos and updates, direct to your inbox.</p>
      <form
        class="signup__form"
        action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0"
        method="post"
        target="_blank"
        novalidate
      >
        <div aria-hidden="true" style="position:absolute;left:-5000px">
          <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
        </div>
        <input class="form-input signup__input" type="text" name="FNAME" placeholder="First name (optional)" autocomplete="given-name" />
        <div class="signup__row">
          <input class="form-input signup__input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
          <button class="btn btn--primary signup__btn" type="submit">Subscribe</button>
        </div>
      </form>
    </section>

    <section class="platforms" id="listen" aria-labelledby="listen-heading">
      <h2 class="section-label" id="listen-heading">Listen</h2>
      <ul class="platform__grid" role="list">
        {platforms.map((p) => (
          <li>
            <a class="platform__link" href={p.href} target="_blank" rel="noreferrer">
              <img class="platform__icon" src={p.icon} alt="" aria-hidden="true" width="22" height="22" />
              <span>{p.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="news" aria-labelledby="news-heading">
      <h2 class="section-label" id="news-heading">Latest</h2>
      <ol class="news__list" role="list">
        {newsItems.map((item) => (
          <li class="news__item">
            <time class="news__date" datetime={item.date}>{fmtDate(item.date)}</time>
            <div class="news__body">
              <strong class="news__title">{item.title}</strong>
              {item.meta && <span class="news__meta">{item.meta}</span>}
            </div>
          </li>
        ))}
      </ol>
    </section>

  </div>

  <footer class="footer">
    <form class="footer__signup" action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0" method="post" target="_blank">
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
      </div>
      <label class="footer__signup-label" for="footer-email">Join the mailing list</label>
      <div class="footer__signup-row">
        <input id="footer-email" class="footer__signup-input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
        <button class="btn btn--ghost footer__signup-btn" type="submit">Subscribe</button>
      </div>
    </form>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="/live/">Live</a>
      <a href="/merch/">Merch</a>
      <a href="/contact/">Contact</a>
    </nav>
    <small class="footer__legal">
      © {new Date().getFullYear()} The Traveller Project · Joshua Chalfen
    </small>
  </footer>

</body>
</html>
