<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Join the List | The Traveller Project</title>
  <meta name="description" content="Sign up for the The Traveller Project mailing list. Be the first to hear new music, demos and updates from Josh Chalfen." />
  <link rel="canonical" href="https://www.thetravellerprojectmusic.co.uk/subscribe/" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://www.thetravellerprojectmusic.co.uk/subscribe/" />
  <meta property="og:title"       content="Join the List | The Traveller Project" />
  <meta property="og:description" content="Be the first to hear new music, demos and updates from The Traveller Project." />
  <meta property="og:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Join the List | The Traveller Project" />
  <meta name="twitter:description" content="Be the first to hear new music, demos and updates from The Traveller Project." />
  <meta name="twitter:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <link rel="icon" type="image/png" href="/favicon.png?v=4" />
  <link rel="apple-touch-icon" href="/favicon.png?v=4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header class="topnav" aria-label="Site navigation">
    <div class="topnav__inner">
      <a class="topnav__logo" href="/">
        <img src="/images/TravProjText.png" alt="The Traveller Project" class="topnav__wordmark" />
      </a>
      <nav class="topnav__links">
        <a class="topnav__item" href="/">Home</a>
        <a class="topnav__item" href="/live/">Live</a>
        <a class="topnav__item" href="/merch/">Merch</a>
        <a class="topnav__item" href="/contact/">Contact</a>
        <a class="topnav__item topnav__item--cta" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </header>

  <div class="subscribe-page">
    <div class="subscribe-inner">

      <header class="subscribe-header">
        <h1 class="subscribe-header__title">Join the list</h1>
        <p class="subscribe-header__desc">
          Be the first to hear new music, demos and updates from The Traveller Project. No spam. Unsubscribe any time.
        </p>
      </header>

      <form
        class="signup__form"
        action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0"
        method="post"
        target="_blank"
        novalidate
      >
        <div aria-hidden="true" style="position:absolute;left:-5000px">
          <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
        </div>
        <input class="form-input signup__input" type="text" name="FNAME" placeholder="First name (optional)" autocomplete="given-name" />
        <div class="signup__row">
          <input class="form-input signup__input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
          <button class="btn btn--primary signup__btn" type="submit">Subscribe</button>
        </div>
      </form>

    </div>
  </div>

  <footer class="footer">
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="/live/">Live</a>
      <a href="/merch/">Merch</a>
      <a href="/contact/">Contact</a>
    </nav>
    <small class="footer__legal">
      © {new Date().getFullYear()} The Traveller Project · Joshua Chalfen
    </small>
  </footer>

</body>
</html>
