---
const videos = [
  {
    id: "yTGnRfX3B9s",
    title: "Wanderer With No Name (Acoustic)",
  },
  {
    id: "UFXaSVdt9WU",
    title: "Blood Spirit (Acoustic)",
  },
];

const shows = [
  {
    day: "6",
    month: "SEP",
    dateLabel: "Sunday 6 September 2026",
    event: "Faversham Hop Festival",
    venue: "The Alex Bar",
    time: "3:00pm",
  },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Live | The Traveller Project</title>
  <meta name="description" content="Watch live acoustic sessions and find upcoming show dates from The Traveller Project, the alt-rock solo project of Josh Chalfen." />
  <link rel="canonical" href="https://www.thetravellerprojectmusic.co.uk/live/" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://www.thetravellerprojectmusic.co.uk/live/" />
  <meta property="og:title"       content="Live | The Traveller Project" />
  <meta property="og:description" content="Watch live acoustic sessions and find upcoming show dates from The Traveller Project." />
  <meta property="og:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Live | The Traveller Project" />
  <meta name="twitter:description" content="Watch live acoustic sessions and find upcoming show dates from The Traveller Project." />
  <meta name="twitter:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <link rel="icon" type="image/png" href="/favicon.png?v=4" />
  <link rel="apple-touch-icon" href="/favicon.png?v=4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header class="topnav" aria-label="Site navigation">
    <div class="topnav__inner">
      <a class="topnav__logo" href="/">
        <img src="/images/TravProjText.png" alt="The Traveller Project" class="topnav__wordmark" />
      </a>
      <nav class="topnav__links">
        <a class="topnav__item" href="/">Home</a>
        <a class="topnav__item" href="/live/">Live</a>
        <a class="topnav__item" href="/merch/">Merch</a>
        <a class="topnav__item" href="/contact/">Contact</a>
        <a class="topnav__item topnav__item--cta" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </header>

  <div class="page-body live-page">

    <header class="live-header">
      <h1 class="live-header__title">Live</h1>
      <p class="live-header__sub">Acoustic sessions and live dates.</p>
    </header>

    <section class="live-shows" aria-labelledby="shows-heading">
      <h2 class="section-label" id="shows-heading">Shows</h2>
      {shows.length > 0 ? (
        <ul class="show-list">
          {shows.map((s) => (
            <li class="show-card">
              <div class="show-card__date">
                <span class="show-card__day">{s.day}</span>
                <span class="show-card__month">{s.month}</span>
              </div>
              <div class="show-card__details">
                <p class="show-card__event">{s.event}</p>
                <p class="show-card__meta">{s.venue} · {s.time}</p>
                <p class="show-card__datelabel">{s.dateLabel}</p>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="live-shows__empty">
          No upcoming dates. <a href="/contact/">Get in touch</a> for bookings.
        </p>
      )}
    </section>

    <section class="live-band" aria-labelledby="band-heading">
      <h2 class="section-label" id="band-heading">Looking for a band</h2>
      <p class="live-band__text">
        The Traveller Project began solo, but is now looking for a drummer, bassist &amp; guitarist to take it to the next level. I have written about 20 songs for the project that take it in a new acoustic rock direction. They need a band to bring them to life. Think Alice In Chains &amp; Staind acoustic, early Coldplay, the gentler side of RHCP. <a href="/contact/">Get in contact</a> if you're interested!
      </p>
      <p class="live-band__byline">- Josh</p>
    </section>

    <section class="live-videos" aria-labelledby="videos-heading">
      <h2 class="section-label" id="videos-heading">Videos</h2>
      <div class="live-video-grid">
        {videos.map((v) => (
          <div class="live-video">
            <div class="live-video__embed">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}`}
                title={v.title}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <p class="live-video__title">{v.title}</p>
          </div>
        ))}
      </div>
    </section>

  </div>

  <footer class="footer">
    <form class="footer__signup" action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0" method="post" target="_blank">
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
      </div>
      <label class="footer__signup-label" for="footer-email">Join the mailing list</label>
      <div class="footer__signup-row">
        <input id="footer-email" class="footer__signup-input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
        <button class="btn btn--ghost footer__signup-btn" type="submit">Subscribe</button>
      </div>
    </form>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="/live/">Live</a>
      <a href="/merch/">Merch</a>
      <a href="/contact/">Contact</a>
    </nav>
    <small class="footer__legal">
      © {new Date().getFullYear()} The Traveller Project · Joshua Chalfen
    </small>
  </footer>

</body>
</html>
