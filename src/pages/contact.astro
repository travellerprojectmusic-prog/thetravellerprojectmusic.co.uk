<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Contact | The Traveller Project</title>
  <meta name="description" content="Get in touch with The Traveller Project — bookings, collaborations, management and songwriting enquiries welcome." />
  <link rel="canonical" href="https://www.thetravellerprojectmusic.co.uk/contact/" />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content="https://www.thetravellerprojectmusic.co.uk/contact/" />
  <meta property="og:title"       content="Contact | The Traveller Project" />
  <meta property="og:description" content="Get in touch with The Traveller Project — bookings, collaborations, management and songwriting enquiries welcome." />
  <meta property="og:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content="Contact | The Traveller Project" />
  <meta name="twitter:description" content="Get in touch with The Traveller Project — bookings, collaborations, management and songwriting enquiries welcome." />
  <meta name="twitter:image"       content="https://www.thetravellerprojectmusic.co.uk/images/bloodbrother.gif" />

  <link rel="icon" type="image/png" href="/favicon.png?v=4" />
  <link rel="apple-touch-icon" href="/favicon.png?v=4" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/styles.css" />
</head>

<body>

  <header class="topnav" aria-label="Site navigation">
    <div class="topnav__inner">
      <a class="topnav__logo" href="/">
        <img src="/images/TravProjText.png" alt="The Traveller Project" class="topnav__wordmark" />
      </a>
      <nav class="topnav__links">
        <a class="topnav__item" href="/">Home</a>
        <a class="topnav__item" href="/live/">Live</a>
        <a class="topnav__item" href="/merch/">Merch</a>
        <a class="topnav__item" href="/contact/">Contact</a>
        <a class="topnav__item topnav__item--cta" href="/subscribe/">Subscribe</a>
      </nav>
    </div>
  </header>

  <div class="page-body contact-page">

    <header class="contact-header">
      <h1 class="contact-header__title">Get in touch</h1>
      <p class="contact-header__sub">Bookings, collaborations, management and mentorship welcome.</p>
    </header>

    <section class="contact-form-section" aria-label="Contact form">
      <div class="form-success" data-fs-success>
        <p>Message received. I'll get back to you soon.</p>
      </div>

      <form id="contact-form" class="contact-form" novalidate>
        <input type="hidden" name="_subject" value="New message — thetravellerprojectmusic.co.uk" />

        <div class="form-field">
          <label class="form-label" for="name">Name</label>
          <input class="form-input" type="text" id="name" name="name" autocomplete="name" />
        </div>

        <div class="form-field">
          <label class="form-label" for="email">
            Email <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input class="form-input" type="email" id="email" name="email" required autocomplete="email" data-fs-field />
          <span class="form-error" data-fs-error="email"></span>
        </div>

        <div class="form-field">
          <label class="form-label" for="message">
            Message <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea class="form-input form-textarea" id="message" name="message" required rows="6" data-fs-field></textarea>
          <span class="form-error" data-fs-error="message"></span>
        </div>

        <button class="btn btn--primary" type="submit" data-fs-submit-btn>Send</button>
      </form>
    </section>

  </div>

  <footer class="footer">
    <form class="footer__signup" action="https://thetravellerprojectmusic.us20.list-manage.com/subscribe/post?u=239ca0fc48bc63f21348cf7e7&id=43380acea1&f_id=003bc2e1f0" method="post" target="_blank">
      <div aria-hidden="true" style="position:absolute;left:-5000px">
        <input type="text" name="b_239ca0fc48bc63f21348cf7e7_43380acea1" tabindex="-1" value="" />
      </div>
      <label class="footer__signup-label" for="footer-email">Join the mailing list</label>
      <div class="footer__signup-row">
        <input id="footer-email" class="footer__signup-input" type="email" name="EMAIL" placeholder="Email address" required autocomplete="email" />
        <button class="btn btn--ghost footer__signup-btn" type="submit">Subscribe</button>
      </div>
    </form>
    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="/live/">Live</a>
      <a href="/merch/">Merch</a>
      <a href="/contact/">Contact</a>
    </nav>
    <small class="footer__legal">
      © {new Date().getFullYear()} The Traveller Project · Joshua Chalfen
    </small>
  </footer>

  <script is:inline>
    window.formspree = window.formspree || function () { (formspree.q = formspree.q || []).push(arguments); };
    formspree('initForm', { formElement: '#contact-form', formId: 'meenaddp' });
  </script>
  <script src="https://unpkg.com/@formspree/ajax@1" defer></script>

</body>
</html>
